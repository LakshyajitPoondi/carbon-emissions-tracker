# PostgreSQL Configuration
POSTGRES_USER=carbon_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=carbon_emissions
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend Configuration
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Auth Configuration
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS — comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redis — Celery broker/result backend, and the WebSocket pub/sub bridge
# used to broadcast from the celery-worker process (see app/pubsub.py)
REDIS_URL=redis://redis:6379/0

# TLS (local dev only) — paths INSIDE the container to the self-signed
# certificate used by the optional `backend-https` service on port 8443.
# Generate them once with:
#   sh backend/scripts/generate-dev-cert.sh
#   (or) powershell -ExecutionPolicy Bypass -File backend\scripts\generate-dev-cert.ps1
# then start it with: docker compose --profile tls up -d backend-https
# These defaults are already baked into docker-compose.yml, so you only need
# to set them if you keep your certificate somewhere else. In production TLS
# is terminated by the hosting platform and neither is used.
TLS_CERT_FILE=/app/certs/dev-cert.pem
TLS_KEY_FILE=/app/certs/dev-key.pem

# HSTS (Strict-Transport-Security) — tells browsers to never speak plain
# HTTP to this origin again. Sent on every response regardless of whether
# this process terminates TLS, because in production a platform terminates
# it upstream and the app only ever sees HTTP (see
# app/middleware/security_headers.py). Browsers ignore the header when it
# arrives over plain HTTP, so leaving this on in local dev is harmless.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
# Leave off unless you intend to submit the domain to the browser preload
# list — that is effectively irreversible on any useful timescale.
HSTS_PRELOAD=false
