# Set to "false" to talk to the real backend instead of the built-in mock
# client. Defaults to the mock (true) if unset — see src/api/config.ts.
# Switching this default is an integration milestone per agents/frontend.md,
# not a routine change.
VITE_USE_MOCK_API=true

# Base URL for the real backend, used only when VITE_USE_MOCK_API=false.
VITE_API_BASE_URL=http://localhost:8000/api

# Show the public Demo Access credential-fill panel. Enable this only when
# the backend deployment also has SEED_DEMO_ACCOUNTS=true.
# Hiding this panel does not revoke demo accounts already seeded in the backend.
VITE_ENABLE_DEMO_ACCESS=false
