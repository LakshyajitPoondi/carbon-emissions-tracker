# Environment secrets
.env

# Real Kubernetes Secret manifest — created locally from
# k8s/secret.example.yaml, which is the committed template. Same reasoning
# as the certificates below: the example shows the shape, the real values
# never enter version control.
k8s/secret.yaml

# Local TLS development certificates — generated per-developer by
# backend/scripts/generate-dev-cert.{sh,ps1}, never committed. A private key
# in version control ends up copied into a real deployment far more often
# than anyone expects, and "it's only a dev cert" is how that starts.
backend/certs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# Docker
postgres_data/

# Baked model weights — fetched by the Dockerfile at build time; also kept
# here on the host because docker-compose's bind mount (./backend:/app)
# shadows whatever the image baked in at /app/models. See
# docs/asset-scan-plan.md point 8 for why both copies are needed.
backend/models/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
